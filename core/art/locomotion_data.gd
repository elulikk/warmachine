## Fotograma interpolado del ciclo `id` en u (0..1, envuelve). Vacio si el ciclo no existe.
static func sample(id: String, u: float) -> Dictionary:
	var cycle: Dictionary = CYCLES.get(id, {}) as Dictionary
	if cycle.is_empty():
		return {}
	var t: float = fposmod(u, 1.0) * float(CYCLE_N)
	var a: int = int(t) % CYCLE_N
	var b: int = (a + 1) % CYCLE_N
	var f: float = t - floorf(t)
	var out: Dictionary = {}
	for k: Variant in cycle.keys():
		var arr: Array = cycle[k] as Array
		out[k] = lerpf(float(arr[a]), float(arr[b]), f)
	return out


## Promedio de un campo del ciclo (para quitarle la postura media y quedarse con la oscilacion).
static func mean(id: String, field: String) -> float:
	var cycle: Dictionary = CYCLES.get(id, {}) as Dictionary
	if cycle.is_empty() or not cycle.has(field):
		return 0.0
	var arr: Array = cycle[field] as Array
	var sum: float = 0.0
	for v: Variant in arr:
		sum += float(v)
	return sum / float(arr.size())
