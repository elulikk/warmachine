[node name="HSeparator1" type="HSeparator" parent="HelpOverlay/CenterContainer/PanelContainer/VBox" unique_id=2090412723]
layout_mode = 2

[node name="RoomGuide" type="Label" parent="HelpOverlay/CenterContainer/PanelContainer/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.95, 0.8, 1)
theme_override_font_sizes/font_size = 13
text = "• HABITACIONES:
  - Hub Central (x:350): Spawn, Herrero y Baúl de Almacenamiento
  - Invocadores (x:-230 a 250): [E] sobre el pod invoca un enemigo del mundo 1; "Limpiar" en x:960
  - Pods (x:420 a 585): Vida, Munición, Granadas y Placa de daño (pararse encima)
  - Ascensor Principal (x:1150): Conecta Hub, Piso Superior y Terraza Alta
  - Torre Oeste (x:-200 a 850): Sprint, Wall Jump y Terraza de Jetpack/Gancho
  - Armería Melee (x:1450 a 2400): Martillo (Stun), Katana (Dash) y Dummies
  - Galería de Tiro (x:1450 a 2700, Nivel Alto): Armas de fuego y Runas con rebote
  - Zona de Práctica (x:2420 a 2720): Runners y Centinela para probar el game feel
  - Laboratorio Químico (x:2750 a 3800): Granadas, Gas combustible y Deflagración
  - Sector Expedición (x:4100 a 5000): Contratos, Dron, Aliado, Oleadas (4 simultáneos) y Extracción"

